						"boxes" : [ 							{
								"box" : 								{
									"id" : "obj-gen-1",
									"maxclass" : "newobj",
									"numinlets" : 0,
									"numoutlets" : 1,
									"outlettype" : [ "" ],
									"patching_rect" : [ 30.0, 20.0, 30.0, 22.0 ],
