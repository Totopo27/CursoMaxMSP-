							}
, 							{
								"box" : 								{
									"id" : "obj-gen-2",
									"maxclass" : "codebox",
									"numinlets" : 1,
									"numoutlets" : 1,
									"outlettype" : [ "" ],
									"patching_rect" : [ 30.0, 60.0, 620.0, 400.0 ],
									"text" : "Param freq(220.0);\r\nParam damping(0.992);\r\nData string_mem(2048);\r\n\r\nHistory write_ptr(0);\r\nHistory prev_samp(0.0);\r\n\r\n// Calculo de muestras de retardo de la cuerda (f = sr / D)\r\n// Compensando 0.5 muestras por el filtro de promedio FIR\r\nd_len = (SAMPLERATE / freq) - 0.5;\r\nd_int = floor(d_len);\r\n\r\n// Lectura del extremo de la cuerda\r\nread_ptr = (write_ptr - d_int + 2048) % 2048;\r\ndelayed_sig = peek(string_mem, read_ptr);\r\n\r\n// Filtro de amortiguacion (Perdida de energia acustica por ciclo)\r\nfiltered = (delayed_sig + prev_samp) * 0.5 * damping;\r\nprev_samp = delayed_sig;\r\n\r\n// Inyeccion de la excitacion inicial (Pua)\r\nnew_sample = in1 + filtered;\r\n\r\n// Escritura en memoria circular\r\npoke(string_mem, new_sample, write_ptr);\r\nwrite_ptr = (write_ptr + 1) % 2048;\r\n\r\nout1 = filtered;"
								}

							}
, 							{
								"box" : 								{
